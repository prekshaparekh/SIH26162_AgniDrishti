# NASA FIRMS API key -- get one free at:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_key_here

# Django
DJANGO_SECRET_KEY=change-me-generate-a-new-one
DEBUG=True

# Geographic scope: lon_min,lat_min,lon_max,lat_max
# Ingestion scope -- the whole state of Gujarat
INGEST_BBOX=68.9,20.0,73.5,23.6
# Validation corridor -- Hazira / Dahej / Bharuch / Ankleshwar
VALIDATION_BBOX=72.4,21.0,73.2,22.0
